# A Cargo workspace built one derivation per crate, from its committed
# crate2nix Cargo.nix, on one system's build context.
#
# packages.<member>  the member's build;  packages.default  all members.
# tests.<member>     the member's test build, its test binaries unrun, and
#                    in target-tmpdir the CARGO_TARGET_TMPDIR they were
#                    compiled with, which a check creates before it runs them;
# checks.<member>    runs the member's test binaries, compiles nothing, or
#                    the check memberChecks gives in its place;
# checks.cargo-nix   the committed Cargo.nix is what the base's crate2nix
#                    generates from the workspace (cargo-nix.nix);
# checks.<extra>     each check extraChecks returns;
# checks.default     every check above: green default is the whole gate.
#
# cargoNix is the workspace root's Cargo.nix, where `crate2nix generate`
# writes it; its directory is the workspace source. memberChecks and
# extraChecks are functions of the system's build context, with `workspace`
# the imported Cargo.nix, `tests` the members' test builds, `check` the
# base's check of a member under a feature set and `doc` rustdoc over a
# member's library under a feature set with rustdoc flags. memberChecks
# returns, by member name, the check that stands in place of the base's, or
# null for a member that has no check. extraChecks returns more checks, by
# names no member, cargo-nix or default has.
context:
{
  cargoNix,
  memberChecks ? _: { },
  extraChecks ? _: { },
}:
let
  inherit (context) pkgs crate2nix buildRustCrateForPkgs crateOverrides;
  lib = pkgs.lib;

  # A Cargo.nix carries crate2nix's library inside it, so it is read only by
  # the crate2nix that wrote it.
  header = lib.take 3 (lib.splitString "\n" (builtins.readFile cargoNix));
  expected = "# This file was @generated by crate2nix ${crate2nix.version} with the command:";
  generated =
    assert lib.assertMsg (lib.elem expected header) ''
      ${toString cargoNix} was not generated by the build base's crate2nix ${crate2nix.version}.
      Regenerate it: nix run github:LiGoldragon/build-base#crate2nix -- generate'';
    import cargoNix {
      inherit pkgs;
      buildRustCrateForPkgs = buildWith buildOverrides;
      defaultCrateOverrides = buildOverrides;
    };

  members = generated.workspaceMembers;

  buildWith = overrides: p: (buildRustCrateForPkgs p).override { defaultCrateOverrides = overrides; };

  # A member's build reads its source without tests/, so an edit to an
  # integration test rebuilds only the member's test build and check, never
  # the member or its dependents. Its test build reads the whole source.
  withoutTests =
    source:
    let
      root = toString (source.origSrc or source);
    in
    lib.cleanSourceWith {
      src = source;
      filter = path: _: path != "${root}/tests" && !lib.hasPrefix "${root}/tests/" path;
    };
  buildOverrides =
    crateOverrides
    // lib.mapAttrs (
      name: _: attributes:
      (crateOverrides.${name} or (_: { })) attributes // { src = withoutTests attributes.src; }
    ) members;

  # The member's crate built with its tests under a feature set, as
  # `cargo test -p <member> --features …` builds it: its library and binaries
  # plus every test target, the binaries left in $out/tests unrun.
  # Dependencies are the same derivations as the build's wherever the
  # feature set and dev-dependencies leave their features unchanged. The
  # member's [[test]] targets are honoured as cargo honours them: a target
  # whose required-features the set lacks is left out, and a target with
  # harness = false is compiled as a plain binary, its own main run by the
  # check.
  testBuild =
    name: features:
    let
      packageId = members.${name}.packageId;
      crateName = generated.internal.crates.${packageId}.crateName;
      crates = generated.internal.builtRustCratesWithFeatures {
        inherit packageId features;
        buildRustCrateForPkgsFunc = buildWith buildOverrides;
        runTests = true;
      };
    in
    crates.crates.${packageId}.override {
      buildTests = true;
      crateOverrides = crateOverrides // {
        ${crateName} =
          attributes:
          let
            given = (crateOverrides.${crateName} or (_: { })) attributes;
            honoured = given // testTargets (attributes // given);
          in
          honoured // targetTmpdir (attributes // honoured);
      };
    };

  # Cargo gives a test, at compile time, CARGO_TARGET_TMPDIR: a directory it
  # may write in when it runs, target/tmp. The test build sets it in its own
  # target directory and records the path in $out/target-tmpdir; a check
  # creates that same absolute path before it runs the binaries.
  targetTmpdir = attributes: {
    preBuild = (attributes.preBuild or "") + ''
      export CARGO_TARGET_TMPDIR="$PWD/target/tmp"
    '';
    postInstall = (attributes.postInstall or "") + ''
      echo "$CARGO_TARGET_TMPDIR" > $out/target-tmpdir
    '';
  };

  # The member's [[test]] targets, as its build's preBuild and postBuild
  # honour them.
  testTargets =
    crate:
    let
      manifest = builtins.fromTOML (builtins.readFile ((crate.src.origSrc or crate.src) + "/Cargo.toml"));
      targets = map (target: target // { path = target.path or "tests/${target.name}.rs"; }) (
        manifest.test or [ ]
      );
      enabled = target: lib.all (feature: lib.elem feature crate.features) (target.required-features or [ ]);
      absent = lib.filter (target: !enabled target) targets;
      harnessless = lib.filter (target: enabled target && !(target.harness or true)) targets;
      # Out of the reach of the scan that compiles tests/*.rs with --test,
      # beside where it stood, so its modules resolve as before.
      aside = target: "${target.path}.harnessless";
    in
    {
      preBuild =
        (crate.preBuild or "")
        + lib.concatMapStrings (target: "rm -f ${lib.escapeShellArg target.path}\n") absent
        + lib.concatMapStrings (
          target: "mv ${lib.escapeShellArg target.path} ${lib.escapeShellArg (aside target)}\n"
        ) harnessless;
      postBuild =
        lib.concatMapStrings (target: ''
          mkdir -p target/bin
          build_bin ${lib.escapeShellArg target.name} ${lib.escapeShellArg (aside target)} target/bin
        '') harnessless
        + (crate.postBuild or "");
    };

  # Runs every test binary of the member's test build under a feature set
  # from a writable copy of its source, the directory cargo runs tests in.
  # Compiles nothing.
  check =
    name: features:
    let
      tests = testBuild name features;
    in
    pkgs.runCommand "check-${name}"
      {
        passthru = { inherit tests; };
      }
      ''
        cp -r ${tests.src} "$NIX_BUILD_TOP/source"
        chmod -R u+w "$NIX_BUILD_TOP/source"
        mkdir -p "$(cat ${tests}/target-tmpdir)"
        cd "$NIX_BUILD_TOP/source"
        for binary in ${tests}/tests/*; do
          echo "running $(basename "$binary")"
          "$binary"
        done
        touch $out
      '';

  # rustdoc over the member's library under a feature set, its dependencies
  # on the --extern and -L path as its build links them: the member's crate
  # build under that feature set, configured as it is, its build script run,
  # the library documented by rustdoc in place of compiled and no binary
  # built. The member's own lints hold, uncapped; flags go to rustdoc after
  # them (doc "member" [ "default" ] [ "-D" "warnings" ]). Compiles nothing
  # but a build script; the documentation is $out/share/doc.
  doc =
    name: features: flags:
    let
      packageId = members.${name}.packageId;
      crates = generated.internal.builtRustCratesWithFeatures {
        inherit packageId features;
        buildRustCrateForPkgsFunc = buildWith buildOverrides;
        runTests = false;
      };
    in
    crates.crates.${packageId}.overrideAttrs (attributes: {
      name = "doc-${name}";
      outputs = [ "out" ];
      outputDev = [ "out" ];
      preBuild = (attributes.preBuild or "") + ''
        build_lib() {
          noisily rustdoc --crate-name "$CRATE_NAME" "$1" -o target/doc \
            -L dependency=target/deps $LIB_RUSTC_OPTS $BUILD_OUT_DIR $EXTRA_FEATURES \
            ${lib.escapeShellArgs flags} --color $colors
        }
        build_bin() { :; }
      '';
      installPhase = ''
        if [ ! -d target/doc ]; then
          echo "${name} has no library to document" >&2
          exit 1
        fi
        mkdir -p $out/share
        cp -r target/doc $out/share/doc
      '';
    });

  source = dirOf cargoNix;

  defaultFeatures = [ "default" ];
  tests = lib.mapAttrs (name: _: testBuild name defaultFeatures) members;
  given = context // {
    workspace = generated;
    inherit tests check doc;
  };

  repositoryMemberChecks = memberChecks given;
  unknownMembers = lib.attrNames (removeAttrs repositoryMemberChecks (lib.attrNames members));
  memberCheckSet =
    assert lib.assertMsg (unknownMembers == [ ]) "memberChecks names no member: ${toString unknownMembers}";
    lib.filterAttrs (_: value: value != null) (
      lib.mapAttrs (name: _: check name defaultFeatures) members // repositoryMemberChecks
    );
  ownChecks = memberCheckSet // {
    cargo-nix = import ./cargo-nix.nix context { inherit source cargoNix generated; };
  };
  consumerChecks = extraChecks given;
  taken = lib.attrNames members ++ [
    "cargo-nix"
    "default"
  ];
  clashes = lib.filter (name: lib.elem name taken) (lib.attrNames consumerChecks);
  checks =
    assert lib.assertMsg (clashes == [ ]) "extraChecks names checks the base already has: ${toString clashes}";
    ownChecks // consumerChecks;
in
{
  inherit tests;

  packages = lib.mapAttrs (_: member: member.build) members // {
    default = generated.allWorkspaceMembers;
  };

  checks = checks // {
    default = pkgs.linkFarm "checks" checks;
  };

  devShell = pkgs.mkShell {
    packages = [
      context.toolchain
      crate2nix
    ];
  };
}

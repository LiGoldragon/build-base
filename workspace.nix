# A Cargo workspace built one derivation per crate, from its committed
# crate2nix Cargo.nix, on one system's build context.
#
# packages.<member>  the member's build;  packages.default  all members.
# tests.<member>     the member's test build, its test binaries unrun;
# checks.<member>    runs the member's test binaries, compiles nothing, or
#                    the check memberChecks gives in its place;
# checks.cargo-nix   the committed Cargo.nix is what the base's crate2nix
#                    generates from the workspace (cargo-nix.nix);
# checks.<extra>     each check extraChecks returns;
# checks.default     every check above: green default is the whole gate.
#
# cargoNix is the workspace root's Cargo.nix, where `crate2nix generate`
# writes it; its directory is the workspace source. memberChecks and
# extraChecks are functions of the system's build context, with `workspace`
# the imported Cargo.nix and `tests` the members' test builds. memberChecks
# returns, by member name, the check that stands in place of the base's, or
# null for a member that has no check. extraChecks returns more checks, by
# names no member, cargo-nix or default has.
context:
{
  cargoNix,
  memberChecks ? _: { },
  extraChecks ? _: { },
}:
let
  inherit (context) pkgs crate2nix buildRustCrateForPkgs crateOverrides;
  lib = pkgs.lib;

  # A Cargo.nix carries crate2nix's library inside it, so it is read only by
  # the crate2nix that wrote it.
  header = lib.take 3 (lib.splitString "\n" (builtins.readFile cargoNix));
  expected = "# This file was @generated by crate2nix ${crate2nix.version} with the command:";
  generated =
    assert lib.assertMsg (lib.elem expected header) ''
      ${toString cargoNix} was not generated by the build base's crate2nix ${crate2nix.version}.
      Regenerate it: nix run github:LiGoldragon/build-base#crate2nix -- generate'';
    import cargoNix {
      inherit pkgs;
      buildRustCrateForPkgs = buildWith buildOverrides;
      defaultCrateOverrides = buildOverrides;
    };

  members = generated.workspaceMembers;

  buildWith = overrides: p: (buildRustCrateForPkgs p).override { defaultCrateOverrides = overrides; };

  # A member's build reads its source without tests/, so an edit to an
  # integration test rebuilds only the member's test build and check, never
  # the member or its dependents. Its test build reads the whole source.
  withoutTests =
    source:
    let
      root = toString (source.origSrc or source);
    in
    lib.cleanSourceWith {
      src = source;
      filter = path: _: path != "${root}/tests" && !lib.hasPrefix "${root}/tests/" path;
    };
  buildOverrides =
    crateOverrides
    // lib.mapAttrs (
      name: _: attributes:
      (crateOverrides.${name} or (_: { })) attributes // { src = withoutTests attributes.src; }
    ) members;

  # The member's crate built with its tests, as `cargo test -p` builds it:
  # its library and binaries plus every test target, the binaries left in
  # $out/tests unrun. Dependencies are the same derivations as the build's
  # wherever the dev-dependencies leave their features unchanged.
  testBuild =
    name:
    let
      packageId = members.${name}.packageId;
      crates = generated.internal.builtRustCratesWithFeatures {
        inherit packageId;
        features = [ "default" ];
        buildRustCrateForPkgsFunc = buildWith buildOverrides;
        runTests = true;
      };
    in
    crates.crates.${packageId}.override {
      buildTests = true;
      crateOverrides = crateOverrides;
    };

  # Runs every test binary of the member from a writable copy of its source,
  # the directory cargo runs tests in. Compiles nothing.
  check =
    name:
    let
      tests = testBuild name;
    in
    pkgs.runCommand "check-${name}"
      {
        passthru = { inherit tests; };
      }
      ''
        cp -r ${tests.src} "$NIX_BUILD_TOP/source"
        chmod -R u+w "$NIX_BUILD_TOP/source"
        cd "$NIX_BUILD_TOP/source"
        for binary in ${tests}/tests/*; do
          echo "running $(basename "$binary")"
          "$binary"
        done
        touch $out
      '';

  source = dirOf cargoNix;

  tests = lib.mapAttrs (name: _: testBuild name) members;
  given = context // {
    workspace = generated;
    inherit tests;
  };

  repositoryMemberChecks = memberChecks given;
  unknownMembers = lib.attrNames (removeAttrs repositoryMemberChecks (lib.attrNames members));
  memberCheckSet =
    assert lib.assertMsg (unknownMembers == [ ]) "memberChecks names no member: ${toString unknownMembers}";
    lib.filterAttrs (_: value: value != null) (
      lib.mapAttrs (name: _: check name) members // repositoryMemberChecks
    );
  ownChecks = memberCheckSet // {
    cargo-nix = import ./cargo-nix.nix context { inherit source cargoNix generated; };
  };
  consumerChecks = extraChecks given;
  taken = lib.attrNames members ++ [
    "cargo-nix"
    "default"
  ];
  clashes = lib.filter (name: lib.elem name taken) (lib.attrNames consumerChecks);
  checks =
    assert lib.assertMsg (clashes == [ ]) "extraChecks names checks the base already has: ${toString clashes}";
    ownChecks // consumerChecks;
in
{
  inherit tests;

  packages = lib.mapAttrs (_: member: member.build) members // {
    default = generated.allWorkspaceMembers;
  };

  checks = checks // {
    default = pkgs.linkFarm "checks" checks;
  };

  devShell = pkgs.mkShell {
    packages = [
      context.toolchain
      crate2nix
    ];
  };
}
